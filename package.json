for h in /sys/class/fc_host/host*; do
  echo "=== $(basename $h) ==="
  echo -n "WWPN:      "; cat $h/port_name
  echo -n "WWNN:      "; cat $h/node_name
  echo -n "Port ID:   "; cat $h/port_id
  echo -n "State:     "; cat $h/port_state
  echo -n "Speed:     "; cat $h/speed
  echo -n "Fabric:    "; cat $h/supported_classes 2>/dev/null || true
  echo
done
