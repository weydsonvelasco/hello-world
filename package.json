NODE=control-plane-1.suportenuvem.caixa

MCD=$(oc get pod -n openshift-machine-config-operator \
  -l k8s-app=machine-config-daemon \
  --field-selector spec.nodeName="${NODE}" \
  -o jsonpath='{.items[0].metadata.name}')

echo "$MCD"

oc logs -n openshift-machine-config-operator "$MCD" \
  -c machine-config-daemon \
  --since=6h |
grep -iE 'error|failed|failure|drain|evict|reboot|degrad|mismatch|timeout|cordon'
