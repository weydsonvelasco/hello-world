#!/bin/bash
set -e
 
is_set=`oc get netnamespaces -l projeto=$(PROJETO)-$(AMBIENTE) -o=jsonpath='{.items[0].egressIPs}' | tr -d []`
 
shopt -s extglob
CLUSTER="${AMBIENTE}_${SITE}"
 
case "${CLUSTER,,}" in
  # OPENSHIFT LOTERIAS-NPRD
  +(des|tqs|hmp)_openshift_nprd_loterias)
  ALOCAIP_RED_NUM=$(ALOCAIP_RED_NUM_OPENSHIFT_LOTERIAS_NPRD)
  ALOCAIP_VERTICAL=$(ALOCAIP_VERTICAL_OPENSHIFT_LOTERIAS_NPRD)
  ALOCAIP_SITE=$(ALOCAIP_SITE_OPENSHIFT_LOTERIAS_NPRD)
  ALOCAIP_AMBIENTE=$(ALOCAIP_AMBIENTE_OPENSHIFT_LOTERIAS_NPRD)
  ALOCAIP_UNIDADE=$(ALOCAIP_UNIDADE_OPENSHIFT_LOTERIAS_NPRD)
  ALOCAIP_INICIO_RANGE=$(ALOCAIP_INICIO_RANGE_OPENSHIFT_LOTERIAS_NPRD)
  ALOCAIP_FIM_RANGE=$(ALOCAIP_FIM_RANGE_OPENSHIFT_LOTERIAS_NPRD)
  ;;
  prd_ctc_canais)
  if [ "$NODESELECTOR" == ob ]
  then
  ALOCAIP_RED_NUM=$(ALOCAIP_RED_NUM_PRD_CANAIS_CTC)
  ALOCAIP_VERTICAL=$(ALOCAIP_VERTICAL_PRD_CANAIS)
  ALOCAIP_SITE=$(ALOCAIP_SITE)
  ALOCAIP_AMBIENTE=$(ALOCAIP_AMBIENTE_PRD_CANAIS)
  ALOCAIP_UNIDADE=$(ALOCAIP_UNIDADE_PRD_CANAIS)
  ALOCAIP_INICIO_RANGE=$(ALOCAIP_INICIO_RANGE_PRD_CANAIS_CTC_OB)
  ALOCAIP_FIM_RANGE=$(ALOCAIP_FIM_RANGE_PRD_CANAIS_CTC_OB)
  else
  ALOCAIP_RED_NUM=$(ALOCAIP_RED_NUM_PRD_CANAIS_CTC)
  ALOCAIP_VERTICAL="$(ALOCAIP_VERTICAL_PRD_CANAIS)"
  ALOCAIP_SITE=$(ALOCAIP_SITE)
  ALOCAIP_AMBIENTE=$(ALOCAIP_AMBIENTE_PRD_CANAIS)
  ALOCAIP_UNIDADE=$(ALOCAIP_UNIDADE_PRD_CANAIS)
  ALOCAIP_INICIO_RANGE=$(ALOCAIP_INICIO_RANGE_PRD_CANAIS_CTC)
  ALOCAIP_FIM_RANGE=$(ALOCAIP_FIM_RANGE_PRD_CANAIS_CTC)
  fi  
  ;;
  prd_dtc_canais)
  ALOCAIP_RED_NUM=$(ALOCAIP_RED_NUM_PRD_CANAIS_DTC)
  ALOCAIP_VERTICAL=$(ALOCAIP_VERTICAL_PRD_CANAIS)
  ALOCAIP_SITE=$(ALOCAIP_SITE_DTC)
  ALOCAIP_AMBIENTE=$(ALOCAIP_AMBIENTE_PRD_CANAIS)
  ALOCAIP_UNIDADE=$(ALOCAIP_UNIDADE_PRD_CANAIS)
  ALOCAIP_INICIO_RANGE=$(ALOCAIP_INICIO_RANGE_PRD_CANAIS_DTC)
  ALOCAIP_FIM_RANGE=$(ALOCAIP_FIM_RANGE_PRD_CANAIS_DTC)
  ;;
  # OKD 4
  +(des|tqs|hmp)_okd4_nprd)
  ALOCAIP_RED_NUM=$(ALOCAIP_RED_NUM_OKD4)
  ALOCAIP_VERTICAL=$(ALOCAIP_VERTICAL_OKD4)
  ALOCAIP_SITE=$(ALOCAIP_SITE_OKD4)
  ALOCAIP_AMBIENTE=$(ALOCAIP_AMBIENTE_OKD4)
  ALOCAIP_UNIDADE=$(ALOCAIP_UNIDADE_OKD4)
  ALOCAIP_INICIO_RANGE=$(ALOCAIP_INICIO_RANGE_OKD4)
  ALOCAIP_FIM_RANGE=$(ALOCAIP_FIM_RANGE_OKD4)
  ;;
  prd_okd4_prd)
  ALOCAIP_RED_NUM=$(ALOCAIP_RED_NUM_OKD4_PRD_CTC)
  ALOCAIP_VERTICAL=$(ALOCAIP_VERTICAL_OKD4_PRD_CTC)
  ALOCAIP_SITE=$(ALOCAIP_SITE_OKD4_PRD_CTC)
  ALOCAIP_AMBIENTE=$(ALOCAIP_AMBIENTE_OKD4_PRD_CTC)
  ALOCAIP_UNIDADE=$(ALOCAIP_UNIDADE_OKD4_PRD_CTC)
  ALOCAIP_INICIO_RANGE=$(ALOCAIP_INICIO_RANGE_OKD4_PRD_CTC)
  ALOCAIP_FIM_RANGE=$(ALOCAIP_FIM_RANGE_OKD4_PRD_CTC)    
  ;;
  # OCP
  +(des|tqs|hmp)_ocp_nprd)
  ALOCAIP_RED_NUM=$(ALOCAIP_RED_NUM_OCP)
  ALOCAIP_VERTICAL=$(ALOCAIP_VERTICAL_OCP)
  ALOCAIP_SITE=$(ALOCAIP_SITE_OCP)
  ALOCAIP_AMBIENTE=$(ALOCAIP_AMBIENTE_OCP)
  ALOCAIP_UNIDADE=$(ALOCAIP_UNIDADE_OCP)
  ALOCAIP_INICIO_RANGE=$(ALOCAIP_INICIO_RANGE_OCP)
  ALOCAIP_FIM_RANGE=$(ALOCAIP_FIM_RANGE_OCP)
  ;;
  prd_ocp_prd)
  ALOCAIP_RED_NUM=$(ALOCAIP_RED_NUM_OCP_PRD)
  ALOCAIP_VERTICAL=$(ALOCAIP_VERTICAL_OCP_PRD)
  ALOCAIP_SITE=$(ALOCAIP_SITE_OCP_PRD)
  ALOCAIP_AMBIENTE=$(ALOCAIP_AMBIENTE_OCP_PRD)
  ALOCAIP_UNIDADE=$(ALOCAIP_UNIDADE_OCP_PRD)
  ALOCAIP_INICIO_RANGE=$(ALOCAIP_INICIO_RANGE_OCP_PRD)
  ALOCAIP_FIM_RANGE=$(ALOCAIP_FIM_RANGE_OCP_PRD)      
  ;;
  # OCP LOTERIAS-PRD
  prd_ocp_loterias)
  echo "OCP LOTERIAS - PRD"
  ALOCAIP_RED_NUM=$(ALOCAIP_RED_NUM_OCP_LOTERIAS_PRD)
  ALOCAIP_VERTICAL=$(ALOCAIP_VERTICAL_OCP_LOTERIAS_PRD)
  ALOCAIP_SITE=$(ALOCAIP_SITE_OCP_LOTERIAS_PRD)
  ALOCAIP_AMBIENTE=$(ALOCAIP_AMBIENTE_OCP_LOTERIAS_PRD)
  ALOCAIP_UNIDADE=$(ALOCAIP_UNIDADE_OCP_LOTERIAS_PRD)
  ALOCAIP_INICIO_RANGE=$(ALOCAIP_INICIO_RANGE_OCP_LOTERIAS_PRD)
  ALOCAIP_FIM_RANGE=$(ALOCAIP_FIM_RANGE_OCP_LOTERIAS_PRD)
  ;;
  *)
  echo "Não encontrei as variavéis necessarias"
  exit 1 ;;
esac
 
echo "##vso[task.setvariable variable=ALOCAIP_RED_NUM_1;]$ALOCAIP_RED_NUM"
echo "##vso[task.setvariable variable=ALOCAIP_VERTICAL_1;]$ALOCAIP_VERTICAL"
echo "##vso[task.setvariable variable=ALOCAIP_SITE_1;]$ALOCAIP_SITE"
echo "##vso[task.setvariable variable=ALOCAIP_AMBIENTE_1;]$ALOCAIP_AMBIENTE"
echo "##vso[task.setvariable variable=ALOCAIP_UNIDADE_1;]$ALOCAIP_UNIDADE"
echo "##vso[task.setvariable variable=ALOCAIP_INICIO_RANGE_1;]$ALOCAIP_INICIO_RANGE"
echo "##vso[task.setvariable variable=ALOCAIP_FIM_RANGE_1;]$ALOCAIP_FIM_RANGE"
